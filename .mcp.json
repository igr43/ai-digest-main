{
  "mcpServers": {
    "tavily": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "tavily-mcp@latest"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "replicate": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "replicate-mcp@alpha", "--tools=code"],
      "env": {
        "REPLICATE_API_TOKEN": "${REPLICATE_API_TOKEN}"
      }
    }
  }
}
